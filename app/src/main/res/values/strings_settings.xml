    <string name="settings_backup_explanation">Save readable copies of all records and settings in a folder you choose. Anyone with access to these files can read them. A local folder survives app uninstall, but not loss of the phone. Keep another copy off the phone for that.</string>
    <!-- Which backups Momentum keeps in the folder; it removes only files it wrote itself. -->
    <string name="settings_backup_kept">Momentum keeps the two newest backups, the last one from each of the latest 7 days with a backup, and the last one from each of the latest 3 months. Its older backups are removed.</string>
    <!-- Backups written by a version that never removed any. %1$d: how many lie in the folder. -->
    <plurals name="settings_backup_old_found">
        <item quantity="one">This folder also holds %1$d backup from an earlier version of Momentum.</item>
        <item quantity="other">This folder also holds %1$d backups from an earlier version of Momentum.</item>
    </plurals>
    <string name="settings_backup_tidy">Tidy up</string>
    <!-- %1$d: how many of the earlier version's backups would be removed. -->
    <plurals name="settings_backup_tidy_title">
        <item quantity="one">Remove %1$d old backup?</item>
        <item quantity="other">Remove %1$d old backups?</item>
    </plurals>
    <!-- Under the question how many to remove. %1$d: how many of the earlier version's backups stay. -->
    <plurals name="settings_backup_tidy_message">
        <item quantity="one">%1$d other stays, by the same rule as Momentum\'s own. This includes old backups of another Momentum app in this folder. It cannot be undone.</item>
        <item quantity="other">%1$d others stay, by the same rule as Momentum\'s own. This includes old backups of another Momentum app in this folder. It cannot be undone.</item>
    </plurals>
