    <!-- The steps a week earns tokens by, one row each, read from the first up, on a time view's Streak part and on Activity's. The line says how the rows add up. -->
    <string name="settings_steps">Tokens a week</string>
    <string name="settings_steps_note">A week earns the tokens of every step it reaches.</string>
    <!-- A row's stepper value: what reaching the step adds to the week. %d: tokens. -->
    <string name="settings_step_tokens_added">+%d</string>
    <!-- Spoken for the stepper of a further step, which shows no label, by its number, counting the first step as 1. -->
    <string name="settings_step_tokens_at">Tokens at step %d</string>
