    <string name="settings_remove_step">Remove step %d</string>
    <string name="settings_add_step">Add a step</string>
    <!-- Tokens inside a sentence that says what a week earns, such as "… earn a token." %d: the tokens, which pick the plural. -->
    <plurals name="settings_tokens">
        <item quantity="one">a token</item>
        <item quantity="other">%d tokens</item>
    </plurals>
