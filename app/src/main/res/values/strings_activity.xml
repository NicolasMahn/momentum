    <!-- Settings: Activity's page. The part that holds the week's days and the activities, each with its routine, named by Activity's own word. -->
    <string name="activity_settings_activities_part">Activities</string>
    <!-- What Activity's third part is called on its page: the week's days, what is planned on each and the reminder that comes on them. -->
    <string name="activity_settings_week_part">Week</string>
    <!-- Over one field per chosen day, named by the day, that opens the list of what may be planned on it. -->
    <string name="activity_settings_planned">Planned</string>
    <!-- The first choice of that list: any activity done that day counts as planned. -->
    <string name="activity_settings_any_activity">Any activity</string>
    <!-- On a row of the Activities list or of an activity's routine, in place of its summary, while a field on the page it opens holds a blank name, a name in use or a number it may not have, which holds Save back. -->
    <string name="activity_settings_to_fix">Something to fix</string>
    <!-- In the fold of an exercise's numbers: whether it is done with a weight. Off, the start weight and the step leave the fold. -->
    <string name="activity_settings_with_weight">With weight</string>
    <!-- Spoken by the way up from an activity's page or a day's page, which shows only where it leads. %s: the Activities list's name, or the activity a day is part of. -->
    <string name="activity_settings_up">Back to %s</string>
    <string name="activity_settings_days_a_week">Days a week</string>
    <!-- Under the row: what reaching the days earns. %1$d: the days, which pick the plural; %2$s: the tokens the first step adds, from settings_tokens. -->
    <plurals name="activity_settings_days_note">
        <item quantity="one">%1$d active day in a week earns %2$s.</item>
        <item quantity="other">%1$d active days in a week earn %2$s.</item>
    </plurals>
    <!-- After that line: the week's rest days. %d: seven less the days, which pick the plural; none at all has its own sentence. -->
    <plurals name="activity_settings_rest_days_note">
        <item quantity="one">The other day is a rest day.</item>
        <item quantity="other">The other %d days are rest days.</item>
    </plurals>
    <string name="activity_settings_no_rest_days_note">There are no rest days.</string>
    <!-- Last on that line, where there is more than one step: the most a week can earn. %d: what every step adds, together, which picks the plural. -->
    <plurals name="activity_settings_days_note_more">
        <item quantity="one">More days earn up to %d token a week.</item>
        <item quantity="other">More days earn up to %d tokens a week.</item>
    </plurals>
