    <string name="checklist_setup_discard_title">Discard the new checklist?</string>
    <string name="checklist_setup_discard_message">Nothing is saved until you create it.</string>
    <!-- On the bar under the Items step while Next waits for an item. -->
    <string name="checklist_setup_items_needed">Add at least one item to continue</string>
    <!-- On the bar while Next or Create wait for a field: an item whose name was cleared, or text typed into "New item" but not added. -->
    <string name="checklist_setup_names_needed">Give every item a name to continue</string>
    <string name="checklist_setup_checkpoint_names_needed">Give every checkpoint a name to continue</string>
    <string name="checklist_setup_checkpoint_items_needed">Add an item to every checkpoint to continue</string>
    <string name="checklist_editor_checkpoint_items_needed">Add an item to every checkpoint to save</string>
    <string name="checklist_setup_text_pending">Add or clear what you typed to continue</string>

