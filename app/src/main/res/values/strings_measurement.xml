<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
    The screen of a measurement a person made. Its name and its unit are shown as typed. Weight keeps
    its own words in strings_weight.xml; none of them is used here.
    -->
    <!-- What a measurement a person made is called where nothing names it, as Weight is called "Weight". -->
    <string name="measurement_destination">Measurement</string>
    <!-- %1$s: the measurement's name; %2$s: its unit. A measurement without a unit shows its name alone. -->
    <string name="measurement_field_label_with_unit">%1$s in %2$s</string>
    <!-- A value: %1$s is the number, %2$s the unit. A measurement without a unit shows the number alone. -->
    <string name="measurement_value_with_unit">%1$s %2$s</string>
    <string name="measurement_save">Save</string>
    <string name="measurement_saved">Saved</string>
    <!-- %s: the date, for example "Sat, Oct 3". -->
    <string name="measurement_remove">Remove the entry for %s</string>
    <!-- %1$s: the value; %2$s: when, for example "yesterday". -->
    <string name="measurement_previous">Previous: %1$s (%2$s)</string>
    <!-- %3$s: the signed change since then, for example "+0.4 cm". -->
    <string name="measurement_previous_with_change">Previous: %1$s (%2$s) · %3$s</string>
    <string name="measurement_error_invalid">Enter a number above zero.</string>
    <!-- %s: the measurement's name. -->
    <string name="measurement_error_changed_before_save">This entry changed elsewhere. Reopen %s before saving.</string>
    <string name="measurement_error_save_failed">Couldn\'t save the entry. Try again.</string>
    <string name="measurement_error_changed_before_delete">This entry changed elsewhere. Review it before deleting.</string>
    <string name="measurement_error_delete_failed">Couldn\'t delete the entry. Try again.</string>
    <!-- %s: the measurement's name. It was deleted while its screen was open. -->
    <string name="measurement_error_deleted">%s was deleted. Nothing was changed.</string>

    <!-- The reminder of a measurement a person made, under its name as the title. Plain words: Mo does not speak for it. -->
    <string name="measurement_reminder_open">Not logged yet today</string>

    <string name="measurement_none_logged">Nothing logged</string>
    <!-- %s: the value. -->
    <string name="measurement_trend">Trend %s</string>

    <!--
    The chart, spoken. %1$s: the measurement's name; %2$d: days shown; %3$s: latest value; %4$s: the
    lowest record, a number alone; %5$s: the highest record, with the unit.
    -->
    <plurals name="measurement_chart_empty">
        <item quantity="one">Chart of %1$s with no known value in the last %2$d day</item>
        <item quantity="other">Chart of %1$s with no known value in the last %2$d days</item>
    </plurals>
    <plurals name="measurement_chart_trend">
        <item quantity="one">Trend of %1$s for the last %2$d day, ending at %3$s</item>
        <item quantity="other">Trend of %1$s for the last %2$d days, ending at %3$s</item>
    </plurals>
    <plurals name="measurement_chart_value">
        <item quantity="one">%1$s for the last %2$d day, ending at %3$s</item>
        <item quantity="other">%1$s for the last %2$d days, ending at %3$s</item>
    </plurals>
    <plurals name="measurement_chart_trend_between">
        <item quantity="one">Trend of %1$s for the last %2$d day, ending at %3$s, records between %4$s and %5$s</item>
        <item quantity="other">Trend of %1$s for the last %2$d days, ending at %3$s, records between %4$s and %5$s</item>
    </plurals>
    <plurals name="measurement_chart_value_between">
        <item quantity="one">%1$s for the last %2$d day, ending at %3$s, records between %4$s and %5$s</item>
        <item quantity="other">%1$s for the last %2$d days, ending at %3$s, records between %4$s and %5$s</item>
    </plurals>
    <!-- %1$s: the selected date; %2$s: its value; %3$s: the trend on that day. -->
    <string name="measurement_chart_selected_none">Selected %1$s: nothing logged</string>
    <string name="measurement_chart_selected">Selected %1$s: %2$s</string>
    <string name="measurement_chart_selected_with_trend">Selected %1$s: %2$s, trend %3$s</string>

    <!-- Statistics, under how far the trend moved. %1$s: the measurement's name; %2$s: where the trend stands now, with the unit. Weight says this in any unit but kilograms. -->
    <string name="measurement_statistics_caption">%1$s trend · now %2$s</string>
    <!-- %s: the measurement's name. -->
    <string name="measurement_statistics_caption_nothing">%s · nothing logged yet</string>

    <!-- Settings: making a measurement, and the page of one a person made. This is the title of its setup. -->
    <string name="measurement_settings_new">New measurement</string>
    <!-- The name a new measurement starts with until one is typed. -->
    <string name="measurement_new_label">Measurement</string>
    <string name="measurement_setup_create">Create measurement</string>
    <!-- Leaving the setup before the measurement is created. -->
    <string name="measurement_setup_discard_title">Discard the new measurement?</string>
    <string name="measurement_setup_discard_message">Nothing is saved until you create it.</string>
    <!-- The field for what is shown after the number, such as cm or %. It may stay empty. -->
    <string name="measurement_settings_unit">Unit (optional)</string>
    <!-- Takes the unit field's label while what was typed cannot be a unit. %d: the most characters a unit may have. -->
    <string name="measurement_settings_unit_invalid">Up to %d characters, without line breaks</string>
    <!-- The field for what the − and + buttons on the measurement's screen add and take, a number such as 0.5. -->
    <string name="measurement_settings_step">Step of the − and + buttons</string>
    <!-- Takes the step field's label while what was typed is no step. %1$d: the largest step; %2$d: the most decimal places it may have. -->
    <string name="measurement_settings_step_invalid">Above 0, up to %1$d, at most %2$d decimal places</string>
    <!-- The part of a measurement's settings page and the step of its setup that hold its unit and its step, between Look and Reminders. -->
    <string name="measurement_settings_unit_part">Unit</string>
    <!-- Under the unit and the step: what changing the unit does not do. -->
    <!-- On the Streak part of a measurement's page, under the steppers "Max. savable tokens" and "A token for every … kept days", only while its bank is the older kind that earns a token for a Monday-to-Sunday week with that many logged days. It says so, and how it becomes the kind every other view has: once a number is changed and saved, the days count from that day on wherever in a week they fall. -->
    <string name="measurement_settings_still_by_week">These days still count within a week, Monday to Sunday. Change a number and save, and from today they count across weeks.</string>
    <string name="measurement_settings_unit_note">Changing the unit converts nothing: the numbers stay as they were recorded.</string>
    <!-- Above the choice of how many days a measurement's trend line follows. -->
    <string name="measurement_settings_trend">Trend line</string>
    <!-- One choice of the trend line's span. %d: the days. -->
    <plurals name="measurement_settings_trend_days">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>
    <!-- Under the trend line's choices. %d: the days chosen. -->
    <plurals name="measurement_settings_trend_note">
        <item quantity="one">The line follows about the last %d day and changes no recorded number.</item>
        <item quantity="other">The line follows about the last %d days and changes no recorded number.</item>
    </plurals>
    <!-- The confirmation's title. %s: the measurement's name, as the user wrote it. -->
    <string name="measurement_settings_delete_title">Delete %s?</string>
    <string name="measurement_settings_delete_message_none">Its settings are deleted. This cannot be undone.</string>
    <!-- %d: how many days hold a record of this measurement. -->
    <plurals name="measurement_settings_delete_message">
        <item quantity="one">Its settings and %d recorded day are deleted. This cannot be undone.</item>
        <item quantity="other">Its settings and %d recorded days are deleted. This cannot be undone.</item>
    </plurals>
    <string name="measurement_settings_delete_failed">Couldn\'t delete. Try again.</string>
    <!-- On the bar of a measurement's page or setup: what was asked is stored, but its reminder could not be scheduled and the change could not be taken back. "Alarm" is the phone's wake alarm in this app, so it is not said here. -->
    <string name="measurement_settings_alarm_not_set">Saved, but its reminder couldn\'t be set.</string>
    <string name="measurement_range_four_weeks">4W</string>
    <string name="measurement_range_three_months">3M</string>
    <string name="measurement_range_all">All</string>
    <string name="measurement_error_invalid_finite">Enter a number.</string>
</resources>
