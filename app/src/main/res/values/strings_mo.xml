<?xml version="1.0" encoding="utf-8"?>
<!--
Mo's words. He is hurt, never angry, and every line names the way out. As a Husk he no longer
speaks, so those lines speak about him in the third person.
-->
<resources>
    <!-- His state, spoken for his figure on Home and on the widget. -->
    <string name="mo_state_blazing">Mo is blazing</string>
    <string name="mo_state_steady">Mo is burning steadily</string>
    <string name="mo_state_dimming">Mo is dimming</string>
    <string name="mo_state_cold">Mo is cold</string>
    <string name="mo_state_husk">Mo has gone out</string>

    <!-- The score. Freezes join the streak with " · " once there are some. -->
    <plurals name="mo_streak_days">
        <item quantity="one">%d day streak</item>
        <item quantity="other">%d day streak</item>
    </plurals>
    <plurals name="mo_freezes">
        <item quantity="one">%d freeze</item>
        <item quantity="other">%d freezes</item>
    </plurals>
    <!-- %1$d: freezes held; %2$d: how many the bank can hold. -->
    <plurals name="mo_freezes_of">
        <item quantity="one">%1$d of %2$d freeze</item>
        <item quantity="other">%1$d of %2$d freezes</item>
    </plurals>
    <!-- %3$s: mo_full or mo_freeze_next_in. -->
    <plurals name="mo_freezes_of_with_note">
        <item quantity="one">%1$d of %2$d freeze, %3$s</item>
        <item quantity="other">%1$d of %2$d freezes, %3$s</item>
    </plurals>
    <!-- The days until the next freeze. They are days with every daily task kept, not calendar days. -->
    <plurals name="mo_freeze_next_in">
        <item quantity="one">%d kept day to go</item>
        <item quantity="other">%d kept days to go</item>
    </plurals>
    <string name="mo_full">full</string>

    <!-- What he says. %s is a list of feature names, for example "Reading, Care". -->
    <string name="mo_line_frozen">A freeze saved your streak yesterday (%s).</string>
    <string name="mo_line_thaw_anything">Log anything to thaw me.</string>
    <string name="mo_line_thaw_needs">Thaw me: %s.</string>
    <!-- The same two for a Husk in the ice. He no longer speaks, so the app says it about him. -->
    <string name="mo_line_thaw_anything_narrated">Any record thaws Mo.</string>
    <string name="mo_line_thaw_needs_narrated">One record thaws Mo: %s.</string>
    <string name="mo_line_nothing_due">Nothing is due today.</string>
    <string name="mo_line_sick">Rest today. Nothing is asked of you.</string>
    <string name="mo_line_husk">Mo has gone out. The next record rekindles him.</string>
    <string name="mo_line_optional_warm">Nothing has to happen today, but %s would warm me.</string>
    <string name="mo_line_optional">Nothing has to happen today. Still possible: %s.</string>
    <string name="mo_line_done_blazing">Everything is done. I\'m blazing!</string>
    <string name="mo_line_done_steady">Everything is done today. That feels good.</string>
    <string name="mo_line_done_warming">Thank you. I can feel it getting warmer.</string>
    <plurals name="mo_line_reading_left">
        <item quantity="one">%d reading minute left this week.</item>
        <item quantity="other">%d reading minutes left this week.</item>
    </plurals>
    <string name="mo_line_still_open">Still open today: %s.</string>
    <string name="mo_line_getting_cold">It\'s getting cold in here.</string>
    <!-- %1$d: days cold; %2$s: the open tasks. -->
    <plurals name="mo_line_cold">
        <item quantity="one">I\'ve been cold for a day. One of these would warm me: %2$s.</item>
        <item quantity="other">I\'ve been cold for %1$d days. One of these would warm me: %2$s.</item>
    </plurals>
    <plurals name="mo_line_husk_open">
        <item quantity="one">Mo has been out for a day. One record rekindles him: %2$s.</item>
        <item quantity="other">Mo has been out for %1$d days. One record rekindles him: %2$s.</item>
    </plurals>

