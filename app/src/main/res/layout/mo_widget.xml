<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mo_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mo_widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- The score sits on top, exactly as it does on Home. -->
    <LinearLayout
        android:id="@+id/mo_widget_score"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mo_widget_coin"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/mo_widget_streak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/mo_widget_streak_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mo_widget_freezes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:maxLines="1"
            android:textColor="@color/mo_widget_freeze_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/mo_widget_cube"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <ImageView
        android:id="@+id/mo_widget_figure"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter" />
</LinearLayout>
