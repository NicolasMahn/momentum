package com.example.workouttracker.feature.eating

import com.example.workouttracker.domain.questions.QuestionEntry
import androidx.compose.runtime.getValue
import androidx.compose.runtime.key
import androidx.compose.runtime.mutableIntStateOf
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.setValue
import androidx.compose.ui.semantics.SemanticsActions
import androidx.compose.ui.test.junit4.createComposeRule
import androidx.compose.ui.test.onNodeWithTag
import androidx.compose.ui.test.performSemanticsAction
import androidx.compose.ui.test.performTextReplacement
import com.example.workouttracker.core.ui.theme.WorkoutTrackerTheme
import com.example.workouttracker.domain.AppState
import com.example.workouttracker.domain.DayChangeResult
import com.example.workouttracker.domain.changingDay
import com.example.workouttracker.domain.compatibility.eatingQuestions
import com.example.workouttracker.domain.questions.withEating
import com.example.workouttracker.feature.questions.QuestionsScreen
import com.example.workouttracker.feature.questions.testTagPrefix
import com.example.workouttracker.feature.questions.words
import com.example.workouttracker.feature.weight.transcript
import java.io.File
import org.junit.Assert.assertEquals
import org.junit.Rule
import org.junit.Test
import org.junit.runner.RunWith
import org.robolectric.RobolectricTestRunner
import org.robolectric.annotation.Config

/**
 * A frozen English and German transcript of Eating's inherited questions screen. The script records
 * node text, state, tags and TalkBack output after each action, including restored saved-day drafts.
 * This pins the shared Questions controls together with Eating's inherited prompts and answers.
 *
 * Set `EATING_SCREEN_WRITE=1` only when the transcript change is deliberate; each run also writes
 * the observed transcript to `build/eating-screen` for review.
 */
@RunWith(RobolectricTestRunner::class)
class EatingScreenWordsTest : EatingScreenStage {
    @get:Rule
    val compose = createComposeRule()

    private var state by mutableStateOf(AppState())
    private var refuse = false
    private var initialDateKey by mutableStateOf<String?>(null)
    private var scene by mutableIntStateOf(0)
    private val lines = mutableListOf<String>()

    /** The time a save is stored at, later than every record of the script. */
    private var clock = 1_000L

    @Test fun english() = compareWithTheRecordedScreen("en")

    @Test
    @Config(qualifiers = "de")
    fun german() = compareWithTheRecordedScreen("de")

    private fun compareWithTheRecordedScreen(language: String) {
        compose.setContent {
            WorkoutTrackerTheme {
                if (scene > 0) {
                    key(scene) {
                        val view = requireNotNull(state.eatingQuestions)
                        QuestionsScreen(
                            state = state,
                            view = view,
                            words = view.words(),
                            onDayChange = { change ->
                                if (refuse) DayChangeResult.Failed else state.changingDay(change, timestampMillis = clock++) { updated -> state = updated; true }
                            },
                            todayKey = EatingScriptToday,
                            testTagPrefix = view.testTagPrefix,
                            initialDateKey = initialDateKey,
                            onInitialDateConsumed = { initialDateKey = null },
                        )
                    }
                }
            }
        }
        playEatingScreen()
        val actual = lines.joinToString("\n", postfix = "\n")
        val expectedFile = File("src/test/frozen/eating/screen-$language.txt")
        File("build/eating-screen").apply { mkdirs() }.resolve("screen-$language.txt").writeText(actual)
        if (System.getenv("EATING_SCREEN_WRITE") == "1") expectedFile.writeText(actual)
        assertEquals(expectedFile.readText(), actual)
    }

    override fun open(records: List<QuestionEntry>, refuse: Boolean, initialDateKey: String?) {
        state = AppState(questionEntries = records).withEating()
        this.refuse = refuse
        this.initialDateKey = initialDateKey
        scene += 1
        compose.waitForIdle()
    }

    override fun select(dateKey: String) {
        compose.onNodeWithTag("questions_eating_date").performTextReplacement(dateKey)
        compose.waitForIdle()
    }

    override fun click(tag: String) {
        compose.onNodeWithTag(tag).performSemanticsAction(SemanticsActions.OnClick)
        compose.waitForIdle()
    }

    override fun type(tag: String, text: String) {
        compose.onNodeWithTag(tag).performTextReplacement(text)
        compose.waitForIdle()
    }

    override fun say(title: String) {
        lines += "## $title"
        lines += compose.transcript()
    }
}
